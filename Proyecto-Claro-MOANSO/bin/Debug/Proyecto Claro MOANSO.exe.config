<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0"
            sku=".NETFramework,Version=v4.8" />
    </startup>

    <connectionStrings>
        <add name="ConexionClaro"
             connectionString="Data Source=localhost;Initial Catalog=ClaroGestionDB;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
